{
  "name": "james-denning",
  "version": "1.0.0",
  "description": "JAMES-DENNING — Organization Operations Workspace",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:mobile": "vite build --config vite.mobile.config.js",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "verify:web": "npm run build:web && node scripts/verify-web-build.mjs",
    "test:guards": "node scripts/test-verification-guards.mjs",
    "test:tasks": "node --test scripts/test-operational-task-client.mjs scripts/test-operational-task-database.mjs scripts/test-task-assignment-endpoint.mjs scripts/test-task-assignment-release.mjs scripts/test-operational-task-records.mjs scripts/test-task-workspace-ui.mjs scripts/test-operational-task-writes.mjs scripts/test-task-queue-ui.mjs",
    "test:checklist": "node --test scripts/test-execution-checklist.mjs && node scripts/check-execution-checklist.mjs",
    "test:history": "node --test scripts/test-run-history.mjs scripts/test-run-monitor-ui.mjs",
    "test:navigation": "node --test scripts/test-navigation-search.mjs scripts/test-mobile-navigation.mjs scripts/test-workspace-navigation.mjs scripts/test-workspace-switch.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@supabase/supabase-js": "^2.99.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@electric-sql/pglite": "^0.3.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
