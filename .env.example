# Copy this file to .env and fill in your values.
# Only public browser-safe values belong in VITE_* variables.

# Supabase — Project: thklwiybjuhrjqrrxyid
VITE_SUPABASE_URL=https://thklwiybjuhrjqrrxyid.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# NEVER add SUPABASE_SERVICE_ROLE_KEY or any other server secret here.
# Vite exposes every VITE_* value in the client bundle. Keep server secrets
# in Supabase Edge Function secrets or another server-side secret store.

# Edge-function release gates are Supabase secrets, listed here for reference
# only. Both default off and are enabled per environment after a reviewed
# backend release (see documentation/JD_AGENT_EXECUTION_ENGINE.md).
# JD_AGENT_REGISTRY_ENABLED=true      # versioned agent registry service
# JD_AGENT_WORKFORCE_ENABLED=true     # runtime specialist workforce deployment
# JD_SKILLS_ENABLED=true              # skills secure import pipeline and catalog
